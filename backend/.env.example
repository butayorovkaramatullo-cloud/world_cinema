# Nusxa oling:  cp .env.example .env   — keyin qiymatlarni oʻzgartiring.
# .env faylini hech qachon GitHubga yuklamang.

# Mahalliy sinov uchun SQLite. Render'da PostgreSQL manzili avtomatik beriladi.
DATABASE_URL=sqlite:///./world_cinema.db

# Uzun tasodifiy satr qoʻying: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=bu-yerga-uzun-tasodifiy-kalit
TOKEN_MINUTES=10080

# Birinchi ishga tushishda shu maʼlumotlar bilan admin yaratiladi
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=kuchli-parol-qoying

# Sayt (frontend) manzillari, vergul bilan
CORS_ORIGINS=https://butayorovkaramatullo-cloud.github.io,http://localhost:8000,http://127.0.0.1:5500

# Namunaviy filmlarni qoʻshish (boʻsh bazada bir marta)
SEED_DEMO_DATA=true

# mock = sinov toʻlovi (pul olinmaydi). Click/Payme keyin ulanadi.
PAYMENT_PROVIDER=mock
PUBLIC_BASE_URL=http://localhost:8000
